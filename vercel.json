{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/**,prompts/**,data/sample.db}",
      "excludeFiles": "{.venv/**,.tools/**,node_modules/**,dist/**,tests/**,specs/**,docs/**,scripts/**,artifacts/**,*.pdf}"
    }
  },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
